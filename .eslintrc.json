{
    "env": {
        "browser": true,
        "es2021": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "script"
    },
    "rules": {
        "no-unused-vars": "warn",
        "no-console": "off",
        "no-undef": "off"
    },
    "globals": {
        "S": "writable",
        "PRESETS": "readonly",
        "vc": "readonly",
        "cr": "readonly",
        "nm": "readonly",
        "polyArea": "readonly",
        "alignSpineToStructGrid": "readonly",
        "slCW": "readonly",
        "slRW": "readonly",
        "slRD": "readonly",
        "slFH": "readonly",
        "slSW": "readonly",
        "slNF": "readonly",
        "updateUI": "readonly",
        "autoFit": "readonly",
        "draw": "readonly"
    }
}
